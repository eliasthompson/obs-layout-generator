{
  "name": "obs-layout-generator",
  "version": "0.1.0",
  "description": "Generate OBS scene layout metrics for multi-participant canvases",
  "keywords": [
    "layout",
    "obs",
    "obs-studio",
    "streaming"
  ],
  "homepage": "https://github.com/eliasthompson/obs-layout-generator#readme",
  "bugs": {
    "url": "https://github.com/eliasthompson/obs-layout-generator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliasthompson/obs-layout-generator.git"
  },
  "license": "MIT",
  "author": "Elias Thompson",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.12.1",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
